{
  "name": "vce-performance",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "data:export": "python3 scripts/export_website.py",
    "predev": "npm run data:export",
    "dev": "next dev",
    "prebuild": "npm run data:export",
    "build": "next build",
    "start": "next start",
    "test": "vitest run --coverage",
    "test:python": "python3 -m unittest discover -s tests -v",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:production": "TEST_PRODUCTION=1 playwright test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "quality:dead": "knip",
    "quality:dupes": "jscpd src --pattern \"**/*.{ts,tsx}\" --min-lines 8 --min-tokens 80 --threshold 1 --ignore \"**/*.test.*,**/*.spec.*,**/*.stories.*\" --noTips",
    "quality:deps": "depcruise src --validate .dependency-cruiser.cjs",
    "quality:god-components": "node scripts/check-god-components.mjs",
    "validate": "node scripts/run-validate.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "next": "^16.2.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.27",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-sonarjs": "^4.0.3",
    "husky": "^9.1.7",
    "jscpd": "^4.2.3",
    "jsdom": "^26.1.0",
    "knip": "^5.88.1",
    "postcss": "^8.5.8",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
