{
  "ignoreBinaries": ["python3"],
  "vitest": { "config": ["config/vitest.config.mts"] },
  "playwright": { "config": ["config/playwright.config.ts"] },
  "tailwind": { "config": ["config/tailwind.config.ts"] },
  "entry": [
    "next.config.{js,ts,mjs}",
    "src/app/**/{page,layout,route,loading,error,not-found}.{ts,tsx}"
